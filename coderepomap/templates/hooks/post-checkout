#!/bin/sh
# RepoMap auto-update hook (post-checkout)
# This hook runs after git checkout

# Arguments:
# $1 - previous HEAD ref
# $2 - new HEAD ref
# $3 - flag (1 = branch checkout, 0 = file checkout)

PREV_HEAD=$1
NEW_HEAD=$2
IS_BRANCH_CHECKOUT=$3

# Only run on branch checkout, not file checkout
if [ "$IS_BRANCH_CHECKOUT" != "1" ]; then
    exit 0
fi

# Resolve the repomap launcher: PATH first, then the interpreter that
# installed this hook (virtualenv installs are not on the hook's PATH).
if command -v repomap >/dev/null 2>&1; then
    REPOMAP="repomap"
elif [ -x "__REPOMAP_PYTHON__" ]; then
    REPOMAP="__REPOMAP_PYTHON__ -m coderepomap"
else
    exit 0
fi

# Check if .repomap directory exists (project is initialized)
if [ ! -d ".repomap" ]; then
    exit 0
fi

# Check if any source files of the configured language(s) changed between branches
CHANGED=$(git diff --name-only "$PREV_HEAD" "$NEW_HEAD" 2>/dev/null | grep -E "__REPOMAP_EXT_PATTERN__" | head -1)

if [ -n "$CHANGED" ]; then
    echo "[RepoMap] Branch changed with source updates, updating repo map..."
    $REPOMAP generate --notify
fi
